AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=eastus

ADMIN_OBJECT_ID=          # object ID of your personal Azure AD account
AUTOMATION_SP_NAME=sp-lab-automation
AUTOMATION_OBJECT_ID=     # object ID of the service principal
AUTOMATION_CLIENT_ID=     # app (client) ID of the service principal
AUTOMATION_CLIENT_SECRET= # client secret — rotate via: az ad sp credential reset --id <client-id>

ADMIN_EMAIL=

# Tailscale — required by tailscale-vm/create-tailscale-vm.sh
TS_AUTHKEY=               # reusable auth key from https://login.tailscale.com/admin/settings/keys
TS_API_KEY=               # API key with Devices write scope from https://login.tailscale.com/admin/settings/keys
TAILNET=-                 # tailnet name or '-' for the default tailnet of the API key
